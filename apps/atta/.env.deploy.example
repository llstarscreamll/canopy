# Atta deploy dotenv (Pulumi AWS + on-prem fleet operator).
# Copy to apps/atta/.env.deploy (gitignored).
# Loaders default ENV_FILE to this file for `mise //apps/atta:deploy*`.
# Do not put local MinIO dummy AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here —
# use AWS SSO, ~/.aws/credentials, or GitHub OIDC.

# --- AWS Pulumi stack (apps/atta/deploy/aws) ---
# Stack slug used for resource naming and Pulumi stack select (staging|prod).
ENV=staging
AWS_ACCOUNT_ID=123456789012
# Must be us-east-1 (CloudFront certs + CloudFront WAF).
AWS_REGION=us-east-1
ROOT_DOMAIN=example.com
APP_SUBDOMAIN=app
MEDIA_SUBDOMAIN=media
API_ORIGIN_SUBDOMAIN=api
CLOUDFLARE_API_TOKEN=
NEON_API_KEY=
# Existing Neon project id (Pulumi does not create or delete it).
NEON_PROJECT_ID=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# ALARM_EMAIL=ops@example.com

# Public about/support metadata written to SSM + Lambda env.
SUPPORT_EMAIL=soporte@example.com
# TERMS_URL=https://example.com/terms
# PRIVACY_URL=https://example.com/privacy
# LICENSE_LABEL=Software propietario

# --- On-prem fleet operator (apps/atta/deploy/onprem) ---
# Required when apps/atta/deploy/onprem/hosts.json is non-empty.
# ONPREM_RELEASE=
# ONPREM_SSH_KEY_PATH=/path/to/id_ed25519
# ONPREM_HOSTS_FILE=apps/atta/deploy/onprem/hosts.json

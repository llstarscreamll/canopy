# Atta dotenv. Other products use apps/<product>/.env.example.
# Loaders resolve ENV_FILE from the Canopy repo root (default apps/atta/.env).
#
# Backend / local onprem
PORT=8080
DEPLOYMENT_TARGET=onprem
# Required: local | staging | production (exact; no aliases).
APP_ENV=local
DATABASE_URL=postgres://atta:atta@localhost:5432/atta?sslmode=disable
RABBITMQ_URL=amqp://atta:atta@localhost:5672/
MINIO_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=atta
AWS_SECRET_ACCESS_KEY=attasecret
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
S3_BUCKET_NAME=atta-local-bucket
S3_PRESIGN_ENDPOINT_URL=https://media.atta.dev
ALLOWED_ORIGINS=https://app.atta.dev,http://app.atta.dev,http://localhost:4200
FRONTEND_URL=https://app.atta.dev
BACKEND_URL=https://app.atta.dev
# Public about/support metadata (GET /api/health).
# Local: SUPPORT_EMAIL defaults to soporte@atta.com if unset.
# Required outside APP_ENV=local (runtime + AWS/on-prem deploy).
# SUPPORT_EMAIL=soporte@atta.com
# TERMS_URL=https://example.com/terms
# PRIVACY_URL=https://example.com/privacy
# LICENSE_LABEL=Software propietario
GEMINI_API_KEY=dummy-gemini-api-key
# Local-only example keys. Generate unique values for non-local deploys: openssl rand -base64 32
INBOX_CREDENTIALS_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
TENANT_SECRETS_ENCRYPTION_KEY=YXR0YS1sb2NhbC1zZWNyZXRzLWtleS0zMmJ5dGVzISE=
MESSAGING_ATTESTATION_SECRET=local-dev-messaging-attestation-secret
# Optional: override temp dir for zip staging (defaults to TMPDIR or OS temp)
# ATTA_WORK_TEMP_DIR=/tmp/atta-work
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# On-prem fleet (Pulumi SSH + Docker Compose — apps/atta/deploy/onprem)
# Copy hosts.example.json → hosts.json (gitignored). Skip the fleet if unset.
# ONPREM_HOSTS_FILE=apps/atta/deploy/onprem/hosts.json
# ONPREM_SSH_KEY_PATH=/path/to/id_ed25519
# ONPREM_RELEASE=

# Infra (Pulumi / AWS Lambda — apps/atta/deploy/aws)
# Do not run `mise //apps/atta:deploy:aws` with the MinIO dummy keys above.
# Use ENV_FILE=apps/atta/.env.aws (omit AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# so the SDK uses SSO or ~/.aws/credentials) or an AWS_PROFILE.
ENV=prod
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
ROOT_DOMAIN=money-path.co
APP_SUBDOMAIN=app
MEDIA_SUBDOMAIN=media
API_ORIGIN_SUBDOMAIN=api
CLOUDFLARE_API_TOKEN=
NEON_API_KEY=
# Existing project id from the Neon Console. Pulumi does not create or delete it.
NEON_PROJECT_ID=
# GEMINI_MODEL=gemini-2.0-flash
# ALARM_EMAIL=ops@example.com

# E2E (Playwright). Unset = local (*.atta.dev). Point these at staging or
# production to run the same suite against that environment.
# E2E_BASE_URL=https://app.atta.dev
# E2E_API_BASE_URL=https://app.atta.dev
# E2E_MEDIA_BASE_URL=https://media.atta.dev

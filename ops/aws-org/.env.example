# Copy to ops/aws-org/.env (gitignored) or point ENV_FILE at another
# org-specific dotenv. One management root per file / run.
#
# Prerequisites: AWS credentials for the management account (e.g. AWS_PROFILE).
# Organizations must already exist (feature set ALL + SCP policy type enabled).
# Enable IAM Identity Center before SSO_PERMISSION_SETS=true.
# ACCOUNT_EMAIL_* must be a real, deliverable plus-addressable mailbox.

ORGANIZATION_NAME=alar
AWS_REGION=us-east-1
NETWORK_HUB=false
PRODUCTS=atta
ENVIRONMENTS=staging,prod

# Plus-addressed emails for CreateAccount (must be unique and deliverable):
#   {ACCOUNT_EMAIL_LOCAL}+{ORGANIZATION_NAME}-{account-slug}@{ACCOUNT_EMAIL_DOMAIN}
ACCOUNT_EMAIL_LOCAL=aws
ACCOUNT_EMAIL_DOMAIN=your-company.com
# ALLOW_EXAMPLE_EMAIL=true   # only for mock/dev; CreateAccount will fail with fake domains

# Create Identity Center permission sets (+ optional AccountAssignments below)
SSO_PERMISSION_SETS=true

# Identity Center user/group UUIDs (Identity store → Users / Groups). Comma-separated.
# Leave empty to skip that assignment. Does not create users — only assignments.
# SSO_PLATFORM_ADMIN_USERS=
# SSO_PLATFORM_ADMIN_GROUPS=
# SSO_STAGING_DEVELOPER_USERS=
# SSO_STAGING_DEVELOPER_GROUPS=
# SSO_STAGING_MCP_USERS=
# SSO_STAGING_MCP_GROUPS=
# SSO_PROD_READONLY_USERS=
# SSO_PROD_READONLY_GROUPS=

# IAM account aliases `{ORGANIZATION_NAME}-{slug}` on member accounts (default true)
ACCOUNT_ALIASES=true

# Detach legacy root DenyLeave* SCPs so Transition OU can allow LeaveOrganization
# (our deny-leave SCP remains on Security / Infrastructure / Workloads). Default true.
DETACH_ROOT_LEAVE_SCP=true

# Org CloudTrail → log-archive + GuardDuty delegated admin → security-tooling
SECURITY_BASELINE=true

# Optional consolidated monthly budget (management account). Requires both vars.
# MONTHLY_BUDGET_USD=200
# BUDGET_ALERT_EMAIL=ops@your-company.com
